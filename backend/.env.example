# Alma · copia este archivo como .env y rellena lo que necesites.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# En producción: CSRF_TRUSTED_ORIGINS=https://tu-backend.onrender.com (para el admin)
CSRF_TRUSTED_ORIGINS=

# Base de datos. Vacío = SQLite en local. En Docker/Render: postgres://usuario:clave@host:5432/base
DATABASE_URL=

# Usuario del panel en producción (se crea al arrancar si no existe)
OWNER_USERNAME=
OWNER_PASSWORD=
# Cargar datos de ejemplo al arrancar si la base está vacía
SEED_DEMO=false
TIME_ZONE=Europe/Madrid

# Datos del negocio (white label: cambia esto y tienes otro centro)
BUSINESS_NAME=Alma Estética
BUSINESS_OWNER=Cris
BUSINESS_ADDRESS=Calle de la Luna 12, bajo
BUSINESS_PHONE=600 123 456
ASSISTANT_NAME=Aura
# Datos legales para el aviso legal y la política de privacidad (obligatorios antes de publicar la web)
BUSINESS_LEGAL_NAME=
BUSINESS_NIF=
BUSINESS_EMAIL=
# Dirección pública de la web (se enlaza la política de privacidad desde Telegram)
PUBLIC_SITE_URL=http://localhost:5173
# Enlace de reseñas de Google (Perfil de Empresa > Pedir reseñas). Vacío = no se piden.
GOOGLE_REVIEW_URL=

# IA open-weight en local con Ollama (https://ollama.com)
#   ollama pull gemma3:4b
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
LLM_TIMEOUT=60
# Para usar Ollama Cloud en vez de Ollama en local:
#   OLLAMA_URL=https://ollama.com
#   OLLAMA_MODEL=gemma4:31b        (nombre exacto de https://ollama.com/search?c=cloud)
#   OLLAMA_API_KEY=tu-clave         (https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Telegram: crea el bot con @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Tu chat_id para recibir avisos de nuevas citas (escribe a @userinfobot para saberlo)
TELEGRAM_OWNER_CHAT_ID=

# Correo para los pedidos a proveedores.
# Por defecto se muestran en la consola. Para enviarlos de verdad con Gmail:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_HOST_USER=tu@gmail.com
#   EMAIL_HOST_PASSWORD=contraseña de aplicación de 16 letras (https://myaccount.google.com/apppasswords)
#   DEFAULT_FROM_EMAIL=tu@gmail.com
# Prueba: python manage.py send_test_email tu@gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=hola@almaestetica.example

# Comparador de precios (https://serpapi.com, el plan gratuito da 100 búsquedas al mes)
SERPAPI_API_KEY=

# Avisos emergentes en el navegador de la dueña (aunque tenga el panel cerrado).
# Genera las claves con: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
